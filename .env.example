# Public browser API origin. The dev script sets this automatically.
VITE_API_BASE_URL="http://localhost:4000/api"

# Backend configuration. Replace secrets in the deployment environment.
PORT=4000
MONGODB_URI="mongodb://127.0.0.1:27017/collegeos"
JWT_SECRET="replace-with-a-random-secret"
COLLEGEOS_BOOTSTRAP_ADMIN_PASSWORD=""
INSTITUTION_EMAIL_DOMAIN="techspire.edu.np"

# Online Coding Lab — execution provider (Judge0 CE by default).
# Self-hosted example: JUDGE0_BASE_URL="http://127.0.0.1:2358"
# RapidAPI example: JUDGE0_BASE_URL="https://judge0.p.rapidapi.com"
#                   JUDGE0_API_KEY="your-rapidapi-key"
# Leave JUDGE0_BASE_URL empty to disable code execution (the lab
# then reports that the execution service is unavailable).
JUDGE0_BASE_URL=""
JUDGE0_API_KEY=""
JUDGE0_HOST="judge0.p.rapidapi.com"
# Optional JSON map overriding provider language ids: {"python": 71}
JUDGE0_LANGUAGE_ID_MAP=""
# Execution limits
CODING_CPU_TIME_LIMIT=5
CODING_MEMORY_LIMIT_KB=262144
CODING_RATE_LIMIT_PER_MINUTE=40