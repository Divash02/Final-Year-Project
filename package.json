{
  "name": "techspirecollege",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 scripts/dev.js",
    "dev:client": "vite frontend --config frontend/vite.config.ts --port=3000 --host=0.0.0.0",
    "server": "node backend/src/server.js",
    "dev:server": "node --watch backend/src/server.js",
    "test": "npm run test:api && npm run test:calendar && npm run test:lms-format && npm run test:policy && npm run test:sanitize && npm run test:navigation",
    "test:api": "node --test --test-concurrency=1 backend/tests/*.test.js",
    "test:calendar": "tsx --test frontend/src/lib/nepaliCalendar.test.ts",
    "test:lms-format": "tsx --test frontend/src/lib/lmsFormat.test.ts",
    "test:policy": "tsx --test frontend/src/lib/passwordPolicy.test.ts",
    "test:sanitize": "tsx --test frontend/src/lib/sanitizeHtml.test.ts",
    "test:navigation": "tsx --test frontend/src/lib/navigation.test.ts",
    "build": "vite build frontend --config frontend/vite.config.ts",
    "preview": "vite preview frontend --config frontend/vite.config.ts",
    "clean": "node -e \"for (const path of ['dist','frontend/dist']) require('node:fs').rmSync(path,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@vitejs/plugin-react": "4.7.0",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "html5-qrcode": "^2.3.8",
    "isomorphic-dompurify": "^2.36.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.10.4",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nepali-date-converter": "^3.4.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "1.50",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "livekit-client": "^2.15.5",
    "livekit-server-sdk": "^2.13.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "description": "CollegeOS is a React/Vite institutional workspace backed by one Express modular monolith and one MongoDB database. It is not currently production-ready as a multi-institution service; see [docs/ARCHITECTURE.md](docs/ARCHITECTURE.md) for the current authorization and tenancy limitations.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
